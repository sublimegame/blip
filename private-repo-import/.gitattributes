# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto eol=lf
# disables end-of-line normalization for binary files ("-text")
*.flac binary
*.jpg binary
*.png binary
*.pdf binary
*.jar binary
*.bmp binary
*.ttf binary
*.a binary
*.gif binary
*.pages binary
*.bin binary
*.exr binary
*.blend binary
*.pages binary
*.ico binary
*.particubes binary
*.exe binary
# *.exe filter=lfs diff=lfs merge=lfs -text
*.dmg filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.sketch filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.msi filter=lfs diff=lfs merge=lfs -text
design/screens.png filter=lfs diff=lfs merge=lfs -text
xptools/windows/bundle_tar_gz.hpp filter=lfs diff=lfs merge=lfs -text
distribution/builds/** filter=lfs diff=lfs merge=lfs -text
distribution/builds/*.txt !filter !diff !merge text
distribution/steam/steamworks_sdk/** filter=lfs diff=lfs merge=lfs -text

