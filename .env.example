# Blip Environment Variables Template
# Copy this file to .env and fill in the actual values

# DigitalOcean Spaces (for deptool)
DIGITALOCEAN_SPACES_AUTH_KEY=DOXXXXXXXXXXXXXXXXXX
DIGITALOCEAN_SPACES_AUTH_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# DigitalOcean Personal Access Token (PAT)
DIGITALOCEAN_PAT=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mailjet
MAILJET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILJET_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Discord Bot
DISCORD_BOT_TOKEN=XXXXXXXXXXXXXXXXXXX.XXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Ding API
DING_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DING_API_CUSTOMER_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Scenario.com (Skybox generation)
SCENARIO_API_KEY=api_XXXXXXXXXXXXXXXXXXXXXXXXXX
SCENARIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Game Server Token
GAME_SERVER_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# GCP/Firebase API Key (Android)
GCP_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Prelude SMS (Ding transactional)
PRELUDE_SMS_TOKEN=sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Amplitude
AMPLITUDE_KEY_PROD_LEGACY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMPLITUDE_KEY_DEV_LEGACY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMPLITUDE_KEY_LINK=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMPLITUDE_KEY_PROD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMPLITUDE_KEY_DEBUG=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub (CI Runner)
GITHUB_ACCESS_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cloudflare
CLOUDFLARE_API_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLOUDFLARE_ZONE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (Discord Bot)
OPENAI_API_KEY_DISCORDBOT=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Hugging Face
HF_API_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Replicate
REPLICATE_TOKEN=r8_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# GGWP
GGWP_API_KEY=X_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# MongoDB Express (user-db-admin)
ME_CONFIG_BASICAUTH_PASSWORD=your_mongo_express_password_here

# Salts
CLIENT_SALT=your_client_salt_here
GAME_SERVER_SALT=your_game_server_salt_here
LUAU_MODULES_HASH_SALT=your_luau_modules_hash_salt_here
